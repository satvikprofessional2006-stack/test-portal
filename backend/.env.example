# Environment variables — copy to .env and fill in values
# Never commit .env to version control

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=examportal
DB_USER=examportal
DB_PASSWORD=examportal
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Code Execution
# Options: subprocess (dev), docker (production)
EXECUTION_BACKEND=subprocess
EXECUTION_TIMEOUT_SECONDS=10
EXECUTION_MEMORY_LIMIT_MB=256
EXECUTION_OUTPUT_LIMIT_BYTES=1048576

# Security
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# CORS — comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend URL (used in emails etc.)
FRONTEND_URL=http://localhost:3000
